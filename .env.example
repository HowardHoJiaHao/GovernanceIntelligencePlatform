# Copy this file to .env and change the passwords:  cp .env.example .env

# --- Login accounts (one per role) ---
ADMIN_USER=admin
ADMIN_PASS=admin123
REPORTER_USER=reporter
REPORTER_PASS=reporter123
USER_USER=user
USER_PASS=user123

# --- Frontend ---
# Flask session signing key. `make env` fills in a random one; otherwise generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left as this placeholder, the app uses a random key and logs everyone out on restart.
SECRET_KEY=change-me-to-a-long-random-string
# Where the frontend finds the backend (docker-compose overrides this with http://backend:5001)
BACKEND_URL=http://localhost:5001

# --- AI (Ollama) ---
# docker-compose overrides this with http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Storage (local runs only; docker-compose sets container paths) ---
# Leave empty to use the project root: ./database.db, ./data, ./chroma_db
DB_PATH=
DATA_ROOT=
CHROMA_PATH=
